# Project configuration — copy to .env and fill in. Never commit .env.
#
# sofa reads its own settings (SOFA_*) from the process environment only
# (src/bet/sofa/config.py, SofaConfig.from_env); their defaults are the
# measured ones, so none has to be set here.

# ─── Provider credentials ────────────────────────────────────────────────
BZZORIO_KEY=                  # sports.bzzoiro.com, the bet-slip-audit skill's
                              # MCP server (.mcp.json) — provider name is
                              # 'bzzoiro', the key it issues is spelled BZZORIO_KEY
