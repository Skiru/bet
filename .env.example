# Project configuration — this file is the ONLY place these are read from.
#
# Resolution is: process environment (os.environ) first, then this file.
# There is no third source: the former silent fallbacks to
# config/api_keys.json and config/odds_api_key.txt were removed because one
# secret living in two files drifts, and a quiet fallback turns that drift into
# odd provider behaviour instead of a config error.
#
# Copy to .env and fill in. Parsed by python-dotenv, so quoting and `export`
# prefixes behave as usual.

# ─── Provider credentials ────────────────────────────────────────────────
# Used by the simple_stats pipeline:
HIGHLIGHTLY_API_KEY=          # soccer.highlightly.net (also accepts RAPIDAPI_KEY)
SPORTDB_API_KEY=              # api.sportdb.dev MCP  (also accepts SPORTDB_KEY)
API_FOOTBALL_KEY=             # api-sports.io
SERPAPI_KEY=                  # google-sports H2H context
ODDS_API_KEY=                 # the-odds-api.com — schedule only, odds unused

# ESPN, tennis-abstract and sackmann need no credential.

# Used elsewhere in the repo:
API_BASKETBALL_KEY=
API_HOCKEY_KEY=
API_VOLLEYBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
THESPORTSDB_API_KEY=
ODDS_API_IO_KEY=
ODDSPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
PANDASCORE_TOKEN=

# ─── Provider quotas ─────────────────────────────────────────────────────
# BET_LIMIT_<PROVIDER> overrides the conservative default compiled into
# src/bet/api_clients/rate_limiter.py. Those defaults are guesses; the real
# number is in the provider's dashboard, so set it here once you know it.
#
#   <n>   cap at n requests per window
#   -1    no local cap (the provider's own 429 becomes the only limit)
#    0    disable the provider entirely
#
# BET_LIMIT_HIGHLIGHTLY=100
# BET_LIMIT_SPORTDB=300
# BET_LIMIT_API_FOOTBALL=100
# BET_LIMIT_ODDS_API=16

# Counters live in betting/data/.api_usage/ and reset daily. After rotating a
# key the old count is stale — clear it with:
#   python3 scripts/simple/reset_provider_quota.py --provider highlightly

# ─── Database ────────────────────────────────────────────────────────────
# bet.db.connection refuses to guess an operational DB. simple_stats defaults
# to betting/data/betting.db; set this to point everything elsewhere.
# BET_DB_PATH=betting/data/betting.db
