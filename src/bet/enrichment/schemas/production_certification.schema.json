{
  "$id": "urn:bet:v83:production-certification",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "certification_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ledger_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "rollback_policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_code_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_environment_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1"
    },
    "window_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "certification_hash",
    "window_id",
    "outcome",
    "runtime_code_digest",
    "runtime_environment_digest",
    "rollback_policy_hash",
    "ledger_sha256",
    "metrics"
  ],
  "type": "object"
}