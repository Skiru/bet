{
  "schema_version": 1,
  "pipeline_id": "bet_pipeline_v1",
  "timezone": "Europe/Warsaw",
  "betting_day": "dynamic",
  "global_rules": {
    "fail_closed": true,
    "point_in_time_required": true,
    "no_pick_before_s7": true,
    "no_coupon_before_s8": true,
    "enrichment_must_not_emit_pick_edge_stake_or_coupon": true,
    "s2_9_required_before_s3": true,
    "no_live_provider_calls_in_contract_pass": true,
    "no_production_db_writes_in_contract_pass": true,
    "operator_workflow": "SUPERBET_MANUAL_BET_BUILDER",
    "odds_optional_for_analysis": true,
    "odds_required_for_ev_bettable_and_final_coupon": true,
    "analysis_candidate_generation_not_blocked_by_missing_odds": true,
    "manual_operator_quote_required_before_bettable": true,
    "human_entered_quote_required": true,
    "final_coupon_blocked_without_visible_operator_quote": true,
    "superbet_bet_builder_combined_odds_operator_screen_only": true,
    "no_combined_bookmaker_odds_computation": true,
    "no_automated_bookmaker_placement": true,
    "many_event_full_day_generation_required": true,
    "tipster_layer_non_primary_evidence": true,
    "tipster_absence_must_be_explicitly_labeled": true,
    "tipster_absence_does_not_block_core_analysis": true,
    "no_event_drop_due_only_to_tipster_absence": true,
    "every_discovered_event_requires_terminal_status_or_reason": true,
    "weather_injury_tournament_context_required": true,
    "use_kilo_code_active_default_model": true,
    "no_local_model_pin_in_agents": true,
    "no_per_agent_model_override_in_betting_agents": true,
    "same_game_builder_groupings_are_ideas_until_human_quote": true,
    "point_in_time_source_timestamp_required": true,
    "unknown_instead_of_guessing_required": true
  },
  "runtime_contract": {
    "default_timeout_seconds": 900,
    "maximum_timeout_seconds": 3600,
    "retry_attempts": 1,
    "retry_backoff_seconds": 1,
    "idempotency": "HASH_CHAINED_RUN_LEDGER",
    "lock": "LEASE_WITH_PROCESS_START_IDENTITY",
    "unresolved_command_request_blocks_resume": true
  },
  "steps": [
    {
      "id": "S0",
      "name": "Settler",
      "phase": "DATA",
      "agent": "bet-settler-postevent",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s0_settler.py",
      "canonical_script": "scripts/pipeline_steps/s0_settler.py",
      "output": "historical_pnl",
      "next": [
        "S1"
      ],
      "hard_rules": [
        "verify_settlement_pnl_against_db",
        "settlement_and_learning_only",
        "no_new_pick_generation"
      ]
    },
    {
      "id": "S1",
      "name": "Discover",
      "phase": "DATA",
      "agent": "bet-researcher",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s1_discover.py",
      "canonical_script": "scripts/pipeline_steps/s1_discover.py",
      "output": "fixtures_shortlist",
      "next": [
        "S1e"
      ],
      "hard_rules": [
        "verify_fixture_identity",
        "full_day_event_universe_required",
        "fixture_identity_point_in_time_required",
        "multi_sport_event_discovery_allowed"
      ]
    },
    {
      "id": "S1e",
      "name": "Canonical Event Universe Ledger",
      "phase": "DATA",
      "agent": "bet-researcher",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s1e_event_ledger.py",
      "canonical_script": "scripts/pipeline_steps/s1e_event_ledger.py",
      "output": "s1e_event_universe_ledger",
      "next": [
        "S2"
      ],
      "hard_rules": [
        "event_identity_validation",
        "exact_s1_hash_binding",
        "complete_identity_deduplicated_event_universe"
      ]
    },
    {
      "id": "S2",
      "name": "Tipsters Discovery",
      "phase": "DATA",
      "agent": "bet-researcher",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s2_tipsters.py",
      "canonical_script": "scripts/pipeline_steps/s2_tipsters.py",
      "output": "tipster_consensus",
      "next": [
        "S2.3"
      ],
      "hard_rules": [
        "tipster_layer_separate_from_verified_facts",
        "tipster_bias_grading_required",
        "tipster_absence_must_be_explicitly_labeled",
        "tipster_absence_does_not_block_core_analysis",
        "no_event_drop_due_only_to_tipster_absence"
      ]
    },
    {
      "id": "S2.3",
      "name": "enrichment_gap_detection",
      "phase": "DATA",
      "agent": "bet-researcher",
      "execution_mode": "agent_artifact",
      "output": "s2_3_enrichment_gaps",
      "next": [
        "S2.5"
      ],
      "hard_rules": [
        "no_pick",
        "no_edge",
        "no_stake",
        "no_coupon",
        "source_bound_only",
        "unknown_or_blocked_for_missing_data",
        "no_production_db_write",
        "no_betting_data_write",
        "point_in_time_required",
        "weather_injury_tournament_context_gap_detection_required",
        "source_gap_inventory_required"
      ]
    },
    {
      "id": "S2.5",
      "name": "provider_enrichment",
      "phase": "DATA",
      "agent": "bet-researcher",
      "execution_mode": "agent_artifact",
      "output": "s2_5_provider_observations",
      "next": [
        "S2.7"
      ],
      "hard_rules": [
        "no_pick",
        "no_edge",
        "no_stake",
        "no_coupon",
        "source_bound_only",
        "unknown_or_blocked_for_missing_data",
        "no_production_db_write",
        "no_betting_data_write",
        "point_in_time_required",
        "source_bound_provider_enrichment_only",
        "operator_odds_optional_for_analysis",
        "no_unverified_provider_claims"
      ]
    },
    {
      "id": "S2.7",
      "name": "source_reconciliation",
      "phase": "DATA",
      "agent": "bet-researcher",
      "execution_mode": "agent_artifact",
      "output": "s2_7_reconciled_facts",
      "next": [
        "S2.9"
      ],
      "hard_rules": [
        "no_pick",
        "no_edge",
        "no_stake",
        "no_coupon",
        "source_bound_only",
        "unknown_or_blocked_for_missing_data",
        "no_production_db_write",
        "no_betting_data_write",
        "point_in_time_required",
        "source_conflict_reconciliation_required",
        "unknown_for_unresolved_data"
      ]
    },
    {
      "id": "S2.9",
      "name": "data_readiness_gate",
      "phase": "DATA",
      "agent": "bet-researcher",
      "execution_mode": "agent_artifact",
      "output": "s2_9_data_readiness",
      "next": [
        "S3"
      ],
      "hard_rules": [
        "no_pick",
        "no_edge",
        "no_stake",
        "no_coupon",
        "source_bound_only",
        "unknown_or_blocked_for_missing_data",
        "no_production_db_write",
        "no_betting_data_write",
        "point_in_time_required",
        "data_quality_label_required",
        "analysis_allowed_without_odds",
        "readiness_not_equal_bettable"
      ]
    },
    {
      "id": "S3",
      "name": "Stats & Probability",
      "phase": "ANALYSIS_BUILD",
      "agent": "bet-modeler",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s3_stats.py",
      "canonical_script": "scripts/pipeline_steps/s3_stats.py",
      "output": "calibrated_probabilities",
      "next": [
        "S4"
      ],
      "hard_rules": [
        "reproducible_statistical_evidence",
        "market_family_probability_inputs_required",
        "no_fake_probabilities",
        "unsupported_market_family_must_be_rejected_or_watch"
      ]
    },
    {
      "id": "S4",
      "name": "Valuator & CLV",
      "phase": "ANALYSIS_BUILD",
      "agent": "bet-modeler",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s4_valuator.py",
      "canonical_script": "scripts/pipeline_steps/s4_valuator.py",
      "output": "expected_value_estimates",
      "next": [
        "S5"
      ],
      "hard_rules": [
        "clv_validation",
        "odds_missing_becomes_price_pending_not_analysis_block",
        "ev_requires_model_probability_and_operator_odds",
        "fair_odds_requires_real_probability_input",
        "no_kelly_or_stake_before_real_operator_odds"
      ]
    },
    {
      "id": "S5",
      "name": "context_motivation_risk",
      "phase": "ANALYSIS_BUILD",
      "agent": "bet-risk-gatekeeper",
      "execution_mode": "agent_artifact",
      "output": "s5_context_motivation_risk",
      "next": [
        "S6"
      ],
      "hard_rules": [
        "injury_lineup_context_required",
        "motivation_and_tournament_context_required",
        "travel_schedule_fatigue_checked",
        "morale_and_recent_result_context_checked",
        "volatility_or_upset_risk_checked",
        "weather_context_required",
        "tipster_sentiment_layer_checked",
        "bet_builder_correlation_precheck",
        "tournament_and_motivation_review_required"
      ]
    },
    {
      "id": "S6",
      "name": "portfolio_repeat_guard",
      "phase": "ANALYSIS_BUILD",
      "agent": "bet-risk-gatekeeper",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s6_repeats.py",
      "canonical_script": "scripts/pipeline_steps/s6_repeats.py",
      "output": "s6_portfolio_repeat_guard",
      "next": [
        "S7"
      ],
      "hard_rules": [
        "repeat_signals_removal",
        "cross_event_and_same_game_correlation_guard",
        "no_chase_after_loss_guard",
        "same_event_leg_conflict_guard"
      ]
    },
    {
      "id": "S7",
      "name": "Hard Approval Gate",
      "phase": "ANALYSIS_BUILD",
      "agent": "bet-risk-gatekeeper",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s5_gate.py",
      "canonical_script": "scripts/pipeline_steps/s5_gate.py",
      "output": "approved_picks",
      "next": [
        "S7b"
      ],
      "hard_rules": [
        "hard_approval_verdict_gate",
        "analytical_status_allowed_without_odds",
        "bettable_blocked_without_manual_quote",
        "counter_evidence_required"
      ]
    },
    {
      "id": "S7b",
      "name": "Superbet Manual Market Mapping",
      "phase": "ANALYSIS_BUILD",
      "agent": "bet-auditor",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s7_validate.py",
      "canonical_script": "scripts/pipeline_steps/s7_validate.py",
      "output": "s7b_superbet_manual_mapping",
      "next": [
        "S8"
      ],
      "hard_rules": [
        "superbet_manual_market_name_line_mapping_only",
        "manual_operator_quote_fields_must_remain_empty",
        "manual_quote_required_when_operator_quote_missing",
        "no_operator_browser_automation",
        "market_name_line_mapping_required"
      ]
    },
    {
      "id": "S8",
      "name": "Superbet Manual Quote Pack",
      "phase": "ANALYSIS_BUILD",
      "agent": "bet-builder",
      "execution_mode": "script",
      "wrapper": "scripts/pipeline_steps/s8_build_coupons.py",
      "canonical_script": "scripts/pipeline_steps/s8_build_coupons.py",
      "output": "s8_superbet_manual_quote_pack",
      "next": [
        "S9"
      ],
      "hard_rules": [
        "quote_card_correlation_warning_required",
        "same_game_builder_correlation_check",
        "no_combined_bookmaker_odds_computation",
        "manual_quote_cards_required",
        "idea_grouping_not_final_coupon",
        "no_staking_without_real_operator_quote"
      ]
    },
    {
      "id": "S9",
      "name": "External Human-Only Validation Gate",
      "phase": "EXECUTION",
      "agent": "bet-risk-gatekeeper",
      "execution_mode": "human_gate",
      "output": "executed_bets_journal",
      "next": [
        "S10"
      ],
      "hard_rules": [
        "manual_user_verification_in_superbet",
        "human_entered_quote_required",
        "final_coupon_blocked_without_visible_operator_quote",
        "human_only_gate_no_agent_substitute",
        "synthetic_or_generated_s9_approval_invalid",
        "agent_generated_human_approved_forbidden"
      ]
    },
    {
      "id": "S10",
      "name": "settlement_handoff",
      "phase": "POST_EVENT",
      "agent": "bet-settler-postevent",
      "execution_mode": "state_only",
      "output": "s10_settlement_handoff",
      "next": [],
      "hard_rules": [
        "final_accounting_verification",
        "settlement_and_learning_only",
        "no_retroactive_pick_mutation",
        "post_session_learning_separate_from_pre_match_analysis"
      ]
    }
  ]
}
