{
  "$schema": "production_surface.schema.json",
  "schema_version": 2,
  "manifest": "config/pipeline_manifest.json",
  "canonical_entrypoints": [
    "scripts/pipeline_steps/run_daily_pipeline.py"
  ],
  "runtime_infrastructure": [
    "scripts/pipeline_steps",
    "src/bet/pipeline"
  ],
  "domain_and_analytics": [
    "src/bet"
  ],
  "providers": [
    "src/bet/api_clients",
    "src/bet/scrapers",
    "src/bet/provider_runtime.py",
    "src/bet/odds_provider_access.py",
    "scripts/odds_sources"
  ],
  "database_runtime": [
    "src/bet/db"
  ],
  "historical_migrations": [
    "src/bet/db/migrations/010_betclic_markets.sql",
    "src/bet/db/migrations/021_retire_betclic_schema.sql"
  ],
  "configuration": [
    "config",
    "pyproject.toml",
    "uv.lock"
  ],
  "betting_agents": [
    ".kilo/agents/bet-executor.md",
    ".kilo/agents/bet-researcher.md",
    ".kilo/agents/bet-modeler.md",
    ".kilo/agents/bet-risk-gatekeeper.md",
    ".kilo/agents/bet-builder.md",
    ".kilo/agents/bet-auditor.md",
    ".kilo/agents/bet-settler-postevent.md"
  ],
  "betting_skills": [
    ".kilo/skills/betting-pipeline-contract/SKILL.md",
    ".kilo/skills/betting-evidence-contract/SKILL.md",
    ".kilo/skills/betting-pipeline-runtime/SKILL.md",
    ".kilo/skills/context-safe-agentics/SKILL.md"
  ],
  "engineering_tools": [
    "scripts"
  ],
  "validators": [
    "scripts/validate_manifest_power_agents.py",
    "scripts/validate_database_access.py",
    "scripts/validate_power_agent_control_plane.py",
    "scripts/validate_provider_registry.py",
    "scripts/validate_production_surface.py",
    "scripts/validate_reachability_graph.py"
  ],
  "tests": [
    "tests"
  ],
  "fixtures": [
    "tests/fixtures"
  ],
  "documentation": [
    "README.md",
    "ARCHITECTURE.md",
    "docs"
  ],
  "generated_ignored_roots": [
    ".kilo/artifacts",
    "reports/pipeline_runs",
    "betting/data",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache"
  ],
  "forbidden_active_patterns": [
    "(?i)legacy_retained_unreachable"
  ],
  "forbidden_tracked_patterns": [
    "(^|/)reports/pipeline_runs/",
    "(^|/)\\.kilo/artifacts/",
    "(?i)(^|/).*(?:backup|bundle).*\\.(?:zip|tar|tgz|gz)$",
    "(?i)(^|/).+\\.log$"
  ]
}
