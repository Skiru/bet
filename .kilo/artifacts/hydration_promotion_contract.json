{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HydrationPromotionContract",
  "type": "object",
  "properties": {
    "hydration_status": {
      "type": "string",
      "enum": [
        "HYDRATED",
        "PARTIAL_HYDRATION",
        "MINIMAL_HYDRATION",
        "HYDRATION_FAILED",
        "DATA_UNAVAILABLE"
      ]
    },
    "promotion_status": {
      "type": "string",
      "enum": [
        "ANALYZABLE",
        "REVIEW_ONLY_PARTIAL_DATA",
        "RESEARCH_GAP_PARTIAL_HYDRATION",
        "RESEARCH_GAP_MINIMAL_HYDRATION",
        "BLOCKED_HYDRATION_FAILED"
      ]
    },
    "source_provider": {
      "type": "string",
      "minLength": 1
    },
    "source_artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "stats_as_of": {
      "type": "string",
      "pattern": "^(?!UNKNOWN$).+"
    },
    "probability_confidence": {
      "type": "string",
      "not": {
        "enum": ["BLOCKED", "LOW", "MINIMAL", "PARTIAL", "LOW_CONFIDENCE"]
      }
    }
  },
  "required": [
    "hydration_status",
    "promotion_status",
    "source_provider",
    "source_artifact_path",
    "stats_as_of",
    "probability_confidence"
  ]
}
