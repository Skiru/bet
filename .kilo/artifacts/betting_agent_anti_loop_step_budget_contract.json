{
  "checklist_max_items": 5,
  "inspection_cap_before_first_action": 3,
  "inspection_cap_exception": "audit_only",
  "failing_operation_max_attempts": 2,
  "change_strategy_after_repeat_failure": true,
  "stop_if_required_tool_unavailable": true,
  "checkpoint_when_step_budget_risk": true,
  "forbid_review_forever": true,
  "forbid_recursive_delegation": true,
  "forbid_false_pass_from_partial_phase": true,
  "require_artifacts_for_phase_pass": true,
  "require_long_session_checkpoints": true,
  "require_schema_bound_outputs": true
}
