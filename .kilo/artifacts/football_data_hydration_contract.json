{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FootballDataHydrationReport",
  "type": "object",
  "required": [
    "candidate_id",
    "home_team",
    "away_team",
    "home_provider_team_id",
    "away_provider_team_id",
    "competition",
    "market_family",
    "required_stats",
    "hydrated_stats",
    "l10_series_home",
    "l10_series_away",
    "stat_semantics",
    "source_provider",
    "source_artifact_path",
    "as_of_utc",
    "hydration_status",
    "gap_reasons"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "home_team": {
      "type": "string"
    },
    "away_team": {
      "type": "string"
    },
    "home_provider_team_id": {
      "type": ["string", "null"]
    },
    "away_provider_team_id": {
      "type": ["string", "null"]
    },
    "competition": {
      "type": "string"
    },
    "market_family": {
      "type": ["string", "null"]
    },
    "required_stats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hydrated_stats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "l10_series_home": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "l10_series_away": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "stat_semantics": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_provider": {
      "type": "string"
    },
    "source_artifact_path": {
      "type": "string"
    },
    "as_of_utc": {
      "type": "string"
    },
    "hydration_status": {
      "type": "string",
      "enum": [
        "HYDRATED",
        "PARTIAL_HYDRATION",
        "L10_SERIES_MISSING",
        "TEAM_IDENTITY_MISSING",
        "PROVIDER_DATA_UNAVAILABLE",
        "STAT_SEMANTICS_UNKNOWN",
        "MARKET_INPUT_NOT_BUILDABLE"
      ]
    },
    "gap_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
