{
  "schema_version": 1,
  "contract_name": "analyzability_prefilter_contract",
  "definitions": {
    "AnalyzabilityReport": {
      "type": "object",
      "required": [
        "candidate_id",
        "sport",
        "market_family",
        "market_type",
        "line",
        "direction",
        "stats_seed_status",
        "l10_series_status",
        "stat_semantics_status",
        "market_probability_input_status",
        "analyzability_score",
        "analyzability_status",
        "blocker_reasons",
        "source_artifact_path",
        "field_path"
      ],
      "properties": {
        "candidate_id": { "type": "string" },
        "sport": { "type": "string" },
        "market_family": { "type": ["string", "null"] },
        "market_type": { "type": ["string", "null"] },
        "line": { "type": ["number", "null"] },
        "direction": { "type": ["string", "null"] },
        "stats_seed_status": { "type": "boolean" },
        "l10_series_status": { "type": "boolean" },
        "stat_semantics_status": { "type": "boolean" },
        "market_probability_input_status": { "type": "boolean" },
        "analyzability_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "analyzability_status": {
          "type": "string",
          "enum": [
            "ANALYZABLE",
            "RESEARCH_GAP_STATS_MISSING",
            "RESEARCH_GAP_L10_MISSING",
            "RESEARCH_GAP_UNKNOWN_STAT_SEMANTICS",
            "RESEARCH_GAP_MARKET_INPUT_NOT_BUILT",
            "UNSUPPORTED_MARKET_FAMILY",
            "IDENTITY_GAP",
            "LINE_OR_DIRECTION_GAP"
          ]
        },
        "blocker_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_artifact_path": { "type": "string" },
        "field_path": { "type": "string" }
      }
    }
  },
  "rules": {
    "only_analyzable_prioritized_for_smoke": true,
    "no_fake_data_fallback": true,
    "block_unsupported_market_families": true,
    "preserve_audit_traceability": true
  }
}
