{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuperbetAnalyticalCandidate",
  "type": "object",
  "required": [
    "candidate_id",
    "event_id",
    "sport",
    "market_family",
    "market_label",
    "analysis_status",
    "odds_status",
    "supporting_evidence",
    "counter_evidence",
    "data_quality",
    "correlation_risk",
    "manual_superbet_quote_required",
    "combined_bookmaker_odds_computed",
    "final_coupon_ready",
    "automated_placement_ready"
  ],
  "properties": {
    "candidate_id": {"type": "string"},
    "event_id": {"type": "string"},
    "sport": {"type": "string"},
    "market_family": {
      "enum": [
        "GOALS_TOTALS",
        "CORNERS",
        "CARDS",
        "SHOTS",
        "SHOTS_ON_TARGET",
        "RESULT",
        "DOUBLE_CHANCE",
        "PLAYER_PROP",
        "TEAM_TOTAL",
        "TOTAL_GAMES",
        "ACES",
        "BREAKS",
        "HANDICAP",
        "OTHER"
      ]
    },
    "market_label": {"type": "string"},
    "direction": {"enum": ["OVER", "UNDER", "HOME", "AWAY", "YES", "NO", "OTHER"]},
    "line": {"type": ["string", "number", "null"]},
    "analysis_status": {"enum": ["NO_BET", "WATCH", "ANALYTICAL_ONLY", "READY_FOR_MANUAL_OPERATOR_QUOTE_REVIEW"]},
    "odds_status": {"enum": ["MISSING_OPERATOR_QUOTE", "REFERENCE_ONLY", "HUMAN_OPERATOR_QUOTE_ENTERED"]},
    "model_probability": {"type": ["number", "null"]},
    "fair_odds": {"type": ["number", "null"]},
    "min_acceptable_operator_odds": {"type": ["number", "null"]},
    "supporting_evidence": {"type": "array"},
    "counter_evidence": {"type": "array"},
    "source_gaps": {"type": "array"},
    "data_quality": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "confidence": {"enum": ["A", "B", "C", "D"]},
    "correlation_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "bet_builder_compatibility": {"enum": ["SINGLE", "SAME_GAME_CANDIDATE", "DO_NOT_COMBINE"]},
    "manual_superbet_quote_required": {"const": true},
    "combined_bookmaker_odds_computed": {"const": false},
    "final_coupon_ready": {"const": false},
    "automated_placement_ready": {"const": false}
  }
}
